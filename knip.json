{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "apps/*/src/main.ts",
        "apps/*/src/main.server.ts",
        "apps/*/src/server.ts",
        "apps/*-e2e/src/**/*.spec.ts",
        "apps/*-e2e/playwright.config.mts",
        "packages/**/src/index.ts",
        "packages/shared/design-tokens/build.mjs",
        "tools/workspace-plugin/src/index.ts",
        "tools/workspace-plugin/src/generators/*/*/*.ts",
        "scripts/verify/*.mjs",
        ".claude/hooks/*.mjs",
        "eslint.angular.mjs",
        "**/eslint.config.mjs",
        "vitest.mutation.config.mts"
      ],
      "project": [
        "apps/**/*.{ts,mts,mjs}",
        "packages/**/*.{ts,mts,mjs}",
        "tools/**/*.{ts,mjs}",
        "scripts/verify/*.mjs",
        ".claude/hooks/*.mjs",
        "*.mjs",
        "*.mts"
      ],
      "ignore": ["**/*.d.ts", "packages/shared/design-tokens/src/**"],
      "ignoreDependencies": [
        "@angular/language-service",
        "@angular/cli",
        "@nx/.*",
        "@eslint/js",
        "@typescript-eslint/utils",
        "autoprefixer",
        "prettier"
      ],
      "ignoreBinaries": ["dot"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "warn",
    "duplicates": "error"
  }
}
