import { Component } from '@angular/core';

/**
 * Entry page for feature-<%= fileName %>.
 * Spec: <%= spec %>
 *
 * Rules (enforced by lint + reviewer agent):
 * - Signals for state (OnPush is the v22 default; never set `Default`), no direct DOM access, no `any`.
