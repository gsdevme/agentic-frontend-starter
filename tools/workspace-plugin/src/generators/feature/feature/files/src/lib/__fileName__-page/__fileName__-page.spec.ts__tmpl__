import { TestBed } from '@angular/core/testing';
import { <%= className %>Page } from './<%= fileName %>-page';

/**
 * Component tests for <%= className %>Page.
 * Each `it` MUST cite the requirement id it verifies (e.g. "REQ-<%= constantName %>-001")
 * from <%= spec %>. The reviewer agent rejects tests without a requirement id.
 */
describe('<%= className %>Page', () => {
  beforeEach(async () => {
    await TestBed.configureTestingModule({
      imports: [<%= className %>Page],
    }).compileComponents();
  });

  it('[REQ-<%= constantName %>-000] renders a single h1 landmark heading', async () => {
    const fixture = TestBed.createComponent(<%= className %>Page);
    await fixture.whenStable();
    const el = fixture.nativeElement as HTMLElement;
    expect(el.querySelectorAll('h1')).toHaveLength(1);
  });
});
