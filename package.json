{
  "name": "@starter/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "verify": "node scripts/verify/all.mjs",
    "verify:quick": "node scripts/verify/all.mjs --quick",
    "verify:all": "node scripts/verify/all.mjs --all",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "e2e": "nx run shell-e2e:e2e",
    "build": "nx run shell:build",
    "serve": "nx run shell:serve",
    "serve:ssr": "node dist/apps/shell/server/server.mjs",
    "tokens": "nx run design-tokens:build",
    "depcruise": "depcruise apps packages tools --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise apps packages tools --config .dependency-cruiser.cjs --output-type dot | dot -T svg > reports/dependency-graph.svg",
    "knip": "knip",
    "mutate": "stryker run",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "prepare": "node .claude/hooks/install-git-hooks.mjs"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.0",
    "@nx/devkit": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/jest": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/playwright": "24.0.0",
    "@nx/plugin": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.2.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.4.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-playwright": "^1.6.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "6.44.1",
    "ng-packagr": "~22.2.0",
    "nx": "24.0.0",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "style-dictionary": "5.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "playwright-core": "1.64.1",
      "playwright": "1.64.1",
      "@playwright/test": "1.64.1"
    }
  },
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-server": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@angular/ssr": "~22.2.0",
    "express": "^4.21.2",
    "rxjs": "~7.8.0"
  }
}
